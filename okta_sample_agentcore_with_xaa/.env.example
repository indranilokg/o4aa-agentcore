# Deploy: AWS credentials and region (optional; boto session may provide)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Deploy: AgentCore custom JWT authorizer (validates incoming id_token)
DISCOVERY_URL=https://your-okta-domain.oktapreview.com/oauth2/your-auth-server-id/.well-known/openid-configuration
OKTA_AUDIENCE=api://your-audience

# Runtime: passed to agent container
HR_MCP_SERVER_URL=https://your-hr-mcp-server.example.com/mcp
MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# After deploy: copy AGENT_RUNTIME_ARN into App/.env to invoke this agent
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:your-account-id:runtime/your-runtime-id

# Cross-App Access (XAA / ID-JAG). When set, agent exchanges id_token for auth-server access token before MCP.
# XAA_OKTA_DOMAIN=https://your-domain.oktapreview.com
# XAA_PRINCIPAL_ID=wlp_your_agent_principal_id
# XAA_AUTHORIZATION_SERVER_ID=your-custom-auth-server-id
# XAA_SCOPE=mcp:read
# XAA_PRIVATE_JWK={"kty":"RSA","kid":"key-id","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}
