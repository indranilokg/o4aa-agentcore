# Deploy: AWS credentials and region (optional; boto session may provide)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-2

# Deploy: AgentCore custom JWT authorizer (validates incoming id_token)
DISCOVERY_URL=https://your-okta-domain.oktapreview.com/oauth2/your-auth-server-id/.well-known/openid-configuration
OKTA_AUDIENCE=api://your-audience

# Runtime: passed to agent container (Gateway URL; agent sends X-ID-Token, interceptor adds Authorization)
HR_MCP_GATEWAY_URL=https://your-gateway-url.example.com/mcp
MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# -----------------------------------------------------------------------------
# Optional: attach Lambda interceptor to Gateway after agent launch
# Deploy the Lambda first (see ../../gateway_interceptor/README.md), then set:
# -----------------------------------------------------------------------------
# ATTACH_INTERCEPTOR=true
# GATEWAY_ID=your-gateway-id
# GATEWAY_NAME=your-gateway-name
# GATEWAY_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/your-gateway-role
# INTERCEPTOR_LAMBDA_ARN=arn:aws:lambda:us-east-2:ACCOUNT_ID:function:agentcore-gateway-mcp-auth-interceptor

# After deploy: copy AGENT_RUNTIME_ARN into App/.env to invoke this agent
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:your-account-id:runtime/your-runtime-id
