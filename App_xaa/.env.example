# Flask
APP_SECRET_KEY=your-flask-secret-key

# Okta OAuth (user login)
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
OKTA_ISSUER_RESOURCE=https://your-okta-domain.oktapreview.com/oauth2/your-auth-server-id
# Local dev: set explicitly. On Render, omit to use https://<your-service>.onrender.com/callback from the request (add that URI in Okta).
OKTA_CALLBACK_URL=http://127.0.0.1:8000/callback
OKTA_SCOPE=openid profile email

# AgentCore runtime to invoke (from agent deploy output)
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:your-account-id:runtime/your-runtime-id

# Optional: fallback bearer token if client credentials flow is not used
# BEARER_TOKEN=your-token
